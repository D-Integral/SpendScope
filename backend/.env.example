# SQLite file used by Prisma
DATABASE_URL="file:./prisma/dev.db"

# HTTP
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
SESSION_SECRET=replace-with-a-long-random-string
CURRENCY=USD

# Set to true to expose POST /api/auth/test/login (used by automated tests).
# Leave false for normal local use with real Google/GitHub SSO.
AUTH_TEST_MODE=false

# Google OAuth / OpenID Connect
# Create an OAuth 2.0 Client ID in Google Cloud Console.
# Authorized JavaScript origin: http://localhost:5173
# Authorized redirect URI:     http://localhost:4000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# GitHub OAuth App
# Homepage URL:   http://localhost:5173
# Callback URL:   http://localhost:4000/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4000/api/auth/github/callback
