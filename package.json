{
  "name": "personal-expense-tracker",
  "private": true,
  "version": "1.0.0",
  "description": "SpendScope — personal expense tracker (Express + React)",
  "scripts": {
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "dev": "concurrently -n api,web -c teal,magenta \"npm run dev --prefix backend\" \"npm run dev --prefix frontend\"",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "test": "npm test --prefix backend",
    "db:push": "npm run db:push --prefix backend",
    "prisma:generate": "npm run prisma:generate --prefix backend"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
